{
  "name": "gooeypi",
  "version": "0.1.9",
  "private": true,
  "description": "A desktop workspace for Pi, OMP, and Prime Agent",
  "main": "out/main/index.js",
  "desktopName": "gooeypi.desktop",
  "author": {
    "name": "GooeyPi contributors",
    "email": "42459108+am-will@users.noreply.github.com"
  },
  "homepage": "https://github.com/am-will/gooey-pi",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && npm run build:bundle",
    "build:bundle": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.tests.json && tsc --noEmit -p tsconfig.scripts.json",
    "lint": "biome lint --config-path=scripts/release/biome.json electron src tests scripts electron.vite.config.ts playwright.config.ts vitest.config.ts",
    "format:check": "biome format --config-path=scripts/release/biome.json scripts/release electron.vite.config.ts vitest.config.ts playwright.config.ts tests/release-scripts.test.ts",
    "check": "npm run lint && npm run format:check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && npm run test:e2e:hermetic",
    "test:e2e:hermetic": "playwright test",
    "release:verify": "npm run release:verify:package && npm run test:e2e:hermetic",
    "release:verify:package": "npm run typecheck && npm run check && npm run test:coverage && npm run build:bundle && npm run release:bundle-size",
    "release:bundle-size": "node scripts/release/verify-bundle-size.mjs",
    "audit:production": "node scripts/release/audit-production.mjs",
    "package:mac": "node scripts/release/package.mjs --public --platform mac",
    "package:mac:local-qa": "node scripts/release/package.mjs --qa --platform mac",
    "package:linux": "node scripts/release/package.mjs --public --platform linux",
    "package:linux:local-qa": "node scripts/release/package.mjs --qa --platform linux",
    "package:win": "node scripts/release/package.mjs --public --platform win",
    "package:win:local-qa": "node scripts/release/package.mjs --qa --platform win",
    "release:preflight": "node scripts/release/preflight.mjs",
    "postinstall": "node scripts/release/install-app-deps.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "node-pty": "^1.0.0",
    "prime-agent": "file:vendor/prime-agent-0.7.0-gooeypi.1.tgz",
    "prime-agent-ai": "file:vendor/prime-agent-ai-0.7.0-gooeypi.1.tgz",
    "rrule": "^2.8.1",
    "zeromq": "^6.1.2"
  },
  "overrides": {
    "@earendil-works/pi-agent-core": "file:vendor/prime-agent-core-0.7.0.tgz",
    "@earendil-works/pi-ai": "$prime-agent-ai",
    "@earendil-works/pi-tui": "file:vendor/prime-agent-tui-0.7.0.tgz"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@electron/asar": "^4.2.1",
    "@electron/fuses": "^2.1.3",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.7",
    "electron-vite": "^5.0.0",
    "js-yaml": "^4.3.1",
    "jsdom": "^26.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.7.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "app.gooeypi.desktop",
    "productName": "GooeyPi",
    "asar": {
      "smartUnpack": false
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "icon": "assets/icon.png",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "GooeyPi uses the microphone for dictation and realtime voice sessions you start."
      },
      "notarize": true,
      "asarUnpack": [
        "**/node_modules/node-pty/build/Release/pty.node",
        "**/node_modules/node-pty/build/Release/spawn-helper",
        "**/node_modules/zeromq/build/darwin/${arch}/node/*-Release/addon.node"
      ],
      "files": [
        "out/**/*",
        "package.json",
        "!**/node_modules/zeromq/build/linux/**",
        "!**/node_modules/zeromq/build/win32/**"
      ]
    },
    "linux": {
      "category": "Development",
      "synopsis": "A desktop workspace for Pi, OMP, and Prime Agent",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "pacman"
      ],
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
      "icon": "assets/icon.png",
      "asarUnpack": [
        "**/node_modules/node-pty/build/Release/pty.node",
        "**/node_modules/zeromq/build/linux/${arch}/node/**/addon.node"
      ],
      "files": [
        "out/**/*",
        "package.json",
        "!**/node_modules/zeromq/build/darwin/**",
        "!**/node_modules/zeromq/build/win32/**"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "${productName}-${version}-win-${arch}.${ext}",
      "icon": "assets/icon.png",
      "asarUnpack": [
        "**/node_modules/node-pty/prebuilds/win32-${arch}/pty.node",
        "**/node_modules/node-pty/prebuilds/win32-${arch}/conpty.node",
        "**/node_modules/node-pty/prebuilds/win32-${arch}/conpty_console_list.node",
        "**/node_modules/node-pty/prebuilds/win32-${arch}/winpty-agent.exe",
        "**/node_modules/node-pty/prebuilds/win32-${arch}/winpty.dll",
        "**/node_modules/node-pty/prebuilds/win32-${arch}/conpty/OpenConsole.exe",
        "**/node_modules/node-pty/prebuilds/win32-${arch}/conpty/conpty.dll",
        "**/node_modules/zeromq/build/win32/${arch}/node/**/addon.node"
      ],
      "files": [
        "out/**/*",
        "package.json",
        "!**/node_modules/zeromq/build/darwin/**",
        "!**/node_modules/zeromq/build/linux/**"
      ]
    },
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "am-will",
      "repo": "gooey-pi"
    },
    "afterPack": "scripts/release/after-pack.cjs",
    "extraResources": [
      {
        "from": "assets/icon.png",
        "to": "icon.png"
      },
      {
        "from": "assets/skills",
        "to": "skills"
      },
      {
        "from": "assets/extensions",
        "to": "extensions"
      },
      {
        "from": "assets/pets",
        "to": "pets"
      }
    ],
    "electronLanguages": [
      "en-US"
    ]
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.9.0"
  },
  "packageManager": "npm@11.12.1"
}
